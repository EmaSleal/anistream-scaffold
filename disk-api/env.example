# Copy this to .env and fill in the values.
# Never commit .env to version control.

# API key for all /api/* endpoints (X-API-Key header).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DISK_API_KEY=

# Root of the legacy storage layout (videos/episodes/<series_id>/...).
# Default: /mnt/data_safe/storage
# DISK_STORAGE_ROOT=/mnt/data_safe/storage

# Jellyfin media root (ADR-018). When set, episode downloads that include
# series_title are written to <root>/<Title> (<Year>)/Season 01/<Title> (<Year>) S01E<NN>.<ext>.
# Unset = legacy layout only. Target value on astro1:
# DISK_MEDIA_ROOT=/srv/media/media/series-dl
